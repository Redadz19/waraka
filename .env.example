APP_NAME=WARAKA Licensing API
ENVIRONMENT=development
DATABASE_URL=sqlite:///./waraka.db
ADMIN_API_KEY=replace-with-long-random-secret
LICENSE_PRIVATE_KEY_B64=
LICENSE_PUBLIC_KEY_B64=
OTP_SECRET=replace-with-at-least-32-random-characters
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=licenses@example.com
OTP_TTL_SECONDS=600
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
MAX_DEVICES_PER_LICENSE=3
OFFLINE_GRACE_DAYS=14
RECHECK_DAYS=7
CORS_ORIGINS=*
